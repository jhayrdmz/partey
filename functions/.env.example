# Copy to functions/.env (deployed) and functions/.env.local (emulator overrides).

# Display pairing code lifetime in seconds
PAIRING_CODE_TTL_SECONDS=180

# Realtime Database URL (your instance's URL; empty in .env.local = the emulator's database)
RTDB_URL=

# Lobby (waiting room) expires after this many minutes with no activity
ROOM_INACTIVITY_MINUTES=60

# Free-tier host limits. Hosts tagged tier "paid" in Firestore hosts/{uid} skip all of these.
# A free host's slot expires, and their rooms end, after this many minutes with no activity
HOST_INACTIVITY_MINUTES=180
# Free hosts allowed to be active at the same time
MAX_ACTIVE_HOSTS=30
# Rooms one free host can have open at once
MAX_ROOMS_PER_HOST=3
# Page linked (opens in a new tab) from the "host limit reached" message; empty = no link
HOST_LIMIT_CONTACT_URL=https://www.facebook.com/JoinPartey
