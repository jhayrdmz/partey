# ─── Partey STAGING Cloud Functions config ──────────────────────────────────
# Copy to functions/.env.preview (gitignored). Firebase loads it on top of functions/.env when
# deploying with `--project preview`. RTDB_URL is required: functions/.env holds PRODUCTION's,
# and staging must never write to production's database (scripts/check-staging-env.mjs checks it).
RTDB_URL=https://your-staging-project-default-rtdb.asia-southeast1.firebasedatabase.app

# Optional overrides for staging (otherwise functions/.env's values apply):
# ROOM_INACTIVITY_MINUTES=60
# HOST_INACTIVITY_MINUTES=180
# MAX_ACTIVE_HOSTS=30
# MAX_ROOMS_PER_HOST=3
# HOST_LIMIT_CONTACT_URL=https://www.facebook.com/JoinPartey
