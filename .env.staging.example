# ─── Partey STAGING web app config ──────────────────────────────────────────
# Copy to .env.staging (gitignored). Used by `npm run build:staging` / `npm run deploy:preview`
# (vite --mode staging), on top of .env. EVERY key below must be set to the STAGING project's
# values, or the production value from .env would leak in: scripts/check-staging-env.mjs refuses
# to build until they are.
# (Firebase console → staging project → Project settings → Your apps → Web app → SDK setup.)
VITE_USE_FIREBASE_EMULATORS=false
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-staging-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-staging-project
VITE_FIREBASE_STORAGE_BUCKET=your-staging-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_URL=https://your-staging-project-default-rtdb.asia-southeast1.firebasedatabase.app
VITE_FIREBASE_FUNCTIONS_REGION=asia-southeast1

# Optional: music (can share production's R2 bucket) and the join-link host.
# VITE_MEDIA_BASE_URL=https://pub-xxxxxxxx.r2.dev
# VITE_PUBLIC_APP_URL=https://your-staging-project.web.app
